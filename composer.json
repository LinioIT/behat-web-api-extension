{
    "name": "linio/behat-web-api-extension",
    "type": "behat-extension",
    "description": "Maintained fork of behat/web-api-extension with extensions and support.",
    "keywords": ["behat", "api", "test"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Christophe Coevoet",
            "email": "stof@notk.org"
        },
        {
            "name": "Community contributors",
            "homepage": "https://github.com/Behat/WebApiExtension/graphs/contributors"
        }
    ],
    "require": {
        "php": ">=8.3.36 <8.4 || >=8.4.27 <8.5 || >=8.5.12 <8.6",
        "behat/behat": "^3.10",
        "guzzlehttp/guzzle": "~6 || ~7",
        "phpunit/phpunit": "6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0"
    },
    "require-dev": {
        "slim/slim": "^4.0",
        "slim/psr7": "^1.5",
        "symfony/process": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Behat\\WebApiExtension\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    }
}
